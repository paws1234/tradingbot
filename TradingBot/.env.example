# Copy to .env and fill in. Never commit .env.

# --- OANDA ---
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
# practice | live — live only with explicit opt-in
ACCOUNT_TYPE=practice
# Comma-separated instruments, e.g. XAU_USD,EUR_USD
INSTRUMENTS=XAU_USD
GRANULARITY=M15

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MIN_CONFIDENCE=7

# --- MongoDB Atlas ---
MONGODB_URI=
MONGODB_DB=tradingbot

# --- Finnhub ---
FINNHUB_API_KEY=

# --- ForexFactory (scraped; unofficial/brittle) ---
# Optional manual override: JSON array of events, used instead of scraping.
# FOREXFACTORY_OVERRIDE=[{"title":"FOMC","time":"2026-08-20T18:00:00Z","currency":"USD","impact":"High"}]

# --- Strategies ---
# Comma-separated IDs: asia_sweep,ema_fvg,atr_breakout,mean_reversion
STRATEGIES=asia_sweep,ema_fvg,atr_breakout,mean_reversion

# --- Filters / risk ---
DAILY_LOSS_LIMIT_PCT=0.03
RISK_PER_TRADE_PCT=0.01
BLACKOUT_MINUTES=30
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
EMA_PERIOD=200
ATR_SL_MULT=2
ATR_TP_MULT=3

# --- Server ---
PORT=8000
